entrypoint = "README.md"
modules = ["javascript", "nodejs-20", "node", "python-3.11", "python3", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/deploy-build.sh"]
run = ["node", "server_dist/index.js"]

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_database:1.0.0", "expo_object_storage:1.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Error Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Clean Metro"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "file-conflict-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "healthcheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ESLint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "eslint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "apostrophe-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hooks-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-client"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Watchdog"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/watchdog.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Error Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/error-monitor.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Clean Metro"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/clean-metro-restart.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/typecheck.sh"

[[workflows.workflow]]
name = "file-conflict-guard"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-file-conflicts.ts"

[[workflows.workflow]]
name = "healthcheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-runtime-health.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit --project server/tsconfig.json"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ESLint"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eslint . --ext .ts,.tsx --max-warnings 9999"

[[workflows.workflow]]
name = "eslint"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/eslint-hooks-check.sh"

[[workflows.workflow]]
name = "apostrophe-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-script-apostrophes.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "hooks-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/eslint-hooks-check.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-client"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/typecheck-client.sh"

[objectStorage]
defaultBucketID = "replit-objstore-ca2daf22-cabb-4140-a095-7b5a6f1afcde"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.production]
NODE_ENV = "production"
EXPO_WEB_URL = "https://biker-link--8081.replit.app"

[userenv.shared]
BIKERLINK_ADMIN_EMAIL = "admin@bikerlink.it"
BIKERLINK_BACKEND_URL = "https://biker-link.replit.app"
EXPO_PUBLIC_DOMAIN = "biker-link.replit.app"
VALHALLA_URL = ""
GRAPHHOPPER_URL = "https://routing.bikerlink.app"
TILES_URL = "https://tiles.bikerlink.app"
ROUTING_DISABLED = "0"

[userenv.development]
EXPO_WEB_URL = "http://localhost:8081"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80
