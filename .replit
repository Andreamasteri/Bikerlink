entrypoint = "README.md"
modules = ["javascript", "nodejs-20", "node", "python-3.11", "python3", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/deploy-build.sh"]
run = ["node", "server_dist/index.js"]

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_database:1.0.0", "expo_object_storage:1.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Diagnose"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Error Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-map-exclusion"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-privacy-filter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Clean Metro"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Publish OTA"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ota-token-safety"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "file-conflict-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-responses"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "version-alignment"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-backend.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-expo.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Watchdog"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/watchdog.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Diagnose"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/diagnose-startup.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Error Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/error-monitor.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "admin-map-exclusion"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-admin-map-exclusion.ts"

[[workflows.workflow]]
name = "admin-privacy-filter"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run --config vitest.config.server.ts"

[[workflows.workflow]]
name = "Clean Metro"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/clean-metro-restart.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Publish OTA"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/publish-ota.sh setup-token && bash scripts/publish-ota.sh publish"

[[workflows.workflow]]
name = "ota-token-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-ota-token-safety.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/typecheck.sh"

[[workflows.workflow]]
name = "file-conflict-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx ts-node scripts/check-file-conflicts.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-responses"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/scripts/check-api-responses.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "version-alignment"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-version-alignment.sh"

[workflows.workflow.metadata]
isValidation = true

[objectStorage]
defaultBucketID = "replit-objstore-ca2daf22-cabb-4140-a095-7b5a6f1afcde"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.production]
NODE_ENV = "production"
EXPO_WEB_URL = "https://biker-link--8081.replit.app"

[userenv.shared]
BIKERLINK_ADMIN_EMAIL = "admin@bikerlink.it"
BIKERLINK_BACKEND_URL = "https://biker-link.replit.app"
EXPO_PUBLIC_DOMAIN = "biker-link.replit.app"

[userenv.development]
EXPO_WEB_URL = "http://localhost:8081"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5051
externalPort = 3000

[[ports]]
localPort = 5999
externalPort = 3001

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002
