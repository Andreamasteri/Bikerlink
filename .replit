entrypoint = "README.md"
modules = ["javascript", "nodejs-20", "node", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/deploy-build.sh"]
run = ["node", "server_dist/index.js"]

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_database:1.0.0", "expo_object_storage:1.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Diagnose"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Error Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ota-guard"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-backend.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-expo.sh"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Watchdog"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/watchdog.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Diagnose"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/diagnose-startup.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Error Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/error-monitor.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ota-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SKIP_LIVE_CHECK=1 bash scripts/validate-ota.sh"

[workflows.workflow.metadata]
outputType = "console"

[objectStorage]
defaultBucketID = "replit-objstore-ca2daf22-cabb-4140-a095-7b5a6f1afcde"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.production]
NODE_ENV = "production"

[userenv.shared]
BIKERLINK_ADMIN_EMAIL = "admin@bikerlink.it"
BIKERLINK_BACKEND_URL = "https://biker-link.replit.app"

[userenv.development]
DEV_SYNC_ALLOWED = "1"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5051
externalPort = 3000

[[ports]]
localPort = 5999
externalPort = 3001
