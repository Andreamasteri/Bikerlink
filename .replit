entrypoint = "README.md"
modules = ["javascript", "nodejs-20", "node", "python-3.11", "python3", "postgresql-16"]

  [nix]
  channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

  [deployment]
  deploymentTarget = "autoscale"
  build = ["bash", "scripts/deploy-build.sh"]
  run = ["bash", "-c", "PORT=5000 node server_dist/index.js"]

  [env]
  PORT = "5000"

  [agent]
  stack = "EXPO"
  integrations = ["javascript_database:1.0.0", "expo_object_storage:1.0.0", "google-drive:1.0.0"]

  [workflows]
runButton = "Project"

  [[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watchdog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Clean Metro"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OTA Publish"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-migration-checks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Diagnostic Report"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "secrets-scan"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-ai-direct-generateobject"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "semgrep"

  [[workflows.workflow]]
  name = "Start App"
  mode = "parallel"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "bash scripts/start.sh"
  waitForPort = 8081

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow]]
  name = "Watchdog"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "bash scripts/watchdog.sh"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow]]
  name = "Clean Metro"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "bash scripts/clean-metro-restart.sh"
  waitForPort = 8081

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow]]
  name = "typecheck"
  author = "agent"

  [workflows.workflow.metadata]
  isValidation = true

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "npx tsc --noEmit -p tsconfig.client.json && npx tsc --noEmit -p server/tsconfig.json"

  [[workflows.workflow]]
  name = "OTA Publish"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "bash scripts/publish-ota-full.sh"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow]]
  name = "Start Backend"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "bash scripts/restart-backend.sh"
  waitForPort = 5000

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow]]
  name = "lint"
  author = "agent"

  [workflows.workflow.metadata]
  isValidation = true

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "npm run lint -- --max-warnings=0"

  [[workflows.workflow]]
  name = "db-migration-checks"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "npx tsx server/scripts/check-schema-migration-drift.ts && npx tsx server/scripts/check-migration-prefix-duplicates.ts && npx tsx scripts/check-index-drift.ts --static-only"

  [workflows.workflow.metadata]
  outputType = "console"

[[workflows.workflow]]
name = "Diagnostic Report"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/dump-diagnostic-report.ts"

[[workflows.workflow]]
name = "secrets-scan"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci-secrets-scan.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-ai-direct-generateobject"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-ai-direct-generateobject.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "semgrep"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-semgrep.sh"

[workflows.workflow.metadata]
isValidation = true

  [objectStorage]
  defaultBucketID = "replit-objstore-ca2daf22-cabb-4140-a095-7b5a6f1afcde"

  [postMerge]
  path = "scripts/post-merge.sh"
timeoutMs = 420000

  [userenv]

  [userenv.production]
  NODE_ENV = "production"
  EXPO_WEB_URL = "https://biker-link--8081.replit.app"

  [userenv.shared]
  BIKERLINK_ADMIN_EMAIL = "admin@bikerlink.it"
  BIKERLINK_BACKEND_URL = "https://biker-link.replit.app"
  EXPO_PUBLIC_DOMAIN = "biker-link.replit.app"
  TILES_URL = "https://tiles.bikerlink.app"
REDIS_PROBE_URL = "https://tc.biker-link.net/probe/redis"
TC_SSH_PORT = "22"
GRAPHHOPPER_URL = "https://gh.biker-link.net"
VALHALLA_URL = "https://valhalla.biker-link.net"
NOMINATIM_URL = "https://nominatim.biker-link.net"
WHISPER_URL = "https://whisper.biker-link.net"
DIAG_OLLAMA_URL = "https://ollama.biker-link.net"
DIAG_OLLAMA_MODEL = "qwen3.6:35b"

  [userenv.development]
  EXPO_WEB_URL = "http://localhost:8081"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 6000
  