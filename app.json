{
  "expo": {
    "name": "BikerLink",
    "slug": "bikerlink",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bikerlink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.bikerlink.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BikerLink usa la tua posizione per mostrare i motociclisti vicini e registrare i tuoi giri.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BikerLink usa la posizione in background per registrare il percorso anche a schermo spento.",
        "NSPhotoLibraryUsageDescription": "BikerLink accede alle tue foto per caricare immagini del profilo e delle moto.",
        "NSCameraUsageDescription": "BikerLink accede alla fotocamera per scattare foto del profilo e delle moto.",
        "NSMusicUsageDescription": "BikerLink accede alla tua libreria musicale per riprodurre brani in-app.",
        "NSAppleMusicUsageDescription": "BikerLink accede ad Apple Music per mostrare e riprodurre brani.",
        "UIBackgroundModes": ["audio", "fetch"]
      }
    },
    "android": {
      "package": "com.bikerlink.app",
      "versionCode": 10,
      "jsEngine": "hermes",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyByoMiBm_D-e3_yG0u-BqwinhjkvbKe0dw"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "bikerlink", "host": "spotify-callback" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "BikerLink accede alla libreria musicale per riprodurre brani.",
          "savePhotosPermission": "BikerLink salva brani nella libreria musicale.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/a25192d7-72e5-46af-97d0-2d38ed9b78e3",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "runtimeVersion": "4.0.0",
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "a25192d7-72e5-46af-97d0-2d38ed9b78e3"
      }
    },
    "owner": "andreamasteri"
  }
}
