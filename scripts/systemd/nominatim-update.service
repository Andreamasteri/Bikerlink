[Unit]
Description=Nominatim OSM Update — BikerLink (diff incrementale Geofabrik)
After=network-online.target postgresql.service
Wants=network-online.target
# NOTA: non si aggiunge Requires/BindsTo=nominatim.service perché lo script
# verifica autonomamente lo stato del servizio e logga un avviso in
# /var/log/nominatim-update.log se non è attivo, terminando senza aggiornare.
# Aggiungere un Requires causerebbe l'avvio automatico di Nominatim da parte
# di systemd (o un fallimento prima di ExecStart), impedendo al log di
# registrare il messaggio di avviso previsto dal requisito.

[Service]
Type=oneshot
User=root
# Lo script usa `sudo -u nominatim` internamente per i comandi nominatim.
ExecStart=/bin/bash /opt/nominatim/scripts/update-nominatim-osm.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nominatim-update

# Timeout generoso: il diff Italia è normalmente <5 minuti, ma in caso di
# diff cumulativi (es. dopo un downtime) può richiedere più tempo.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
