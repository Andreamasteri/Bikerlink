# Dominio del backend BikerLink (senza https://)
# Copia questo file in .env prima di buildare in Android Studio:
#   cp .env.example .env
EXPO_PUBLIC_DOMAIN=biker-link.net

# Ambiente del backend: development | staging | production.
# Il target DB è sempre esplicito: non usare DATABASE_URL generica.
BIKERLINK_DEPLOY_ENV=development
DATABASE_URL_DEV=
DATABASE_URL_CANDIDATE=
DATABASE_URL_PRODUCTION=

# Cloudflare R2 (necessarie solo quando si usa lo storage R2 o la migrazione manuale).
# Non inserire valori reali in questo file.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=https://media.biker-link.net

# Migrazione manuale Replit -> R2.
# Il comando è sempre dry-run salvo l'opzione --execute.
R2_MIGRATION_STATE_FILE=.r2-migration-state.json

# Inactive AI-Hub wiring (no traffic while the flag is false).
# AI_HUB_BEARER_TOKEN is a secret name only; never commit its value.
AI_HUB_WIRING_ENABLED=false
AI_HUB_CONTROL_URL=
AI_HUB_BEARER_TOKEN=
