{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "release-apk": {
      "distribution": "internal",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app",
        "EXPO_PUBLIC_TC_DISPLAY_HOST": "tc.biker-link.net"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      }
    }
  },
  "submit": {}
}
