# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Runtime artifacts
nohup.out

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
.metro-cache/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.backup
BackSecr

# typescript
*.tsbuildinfo

# Next.js build output
.next/
website/.next/

.env

# Stress test logs (keep apk-build-history.log tracked; keep ota-timing.log for historical comparisons)
logs/*.log
logs/*.txt
logs/*.json
logs/*.jsonl
!logs/apk-build-history.log
!logs/ota-timing.log
!logs/ota-hwm.txt
logs/ai-diagnosis-*.md
logs/nadir-manual-*.md

# Task #50 — Memoria persistente di Horus (note runtime, non versionare)
inbox/

# Static build (generated artifacts — non includere nel repo)
static-build/

# OTA build artifacts (rimossi da cleanup trap in publish-ota.sh)
dist-ota/

# OTA publish token (generato da 'bash scripts/publish-ota.sh setup-token', mai committare)
.local/ota-token

# Compiled server
server_dist/
server_dist/index.js
# Migration hash cache — must never be committed; a fresh deploy must always
# re-validate the schema against the DB instead of hitting a stale cache hit.
server_dist/.migrations-hash
# android/ NON è ignorato — android/.gitignore gestisce i build artifacts
# I file critici (build.gradle, AndroidManifest.xml, adi-registration.properties)
# devono rimanere tracciati in git per le build EAS/Play Console
server/data/schema-snapshot.json

# Screenshot e asset incollati dalla chat — non devono essere tracciati
attached_assets/

# Exports — contengono dati di esportazione (ZIP, task, chat history) che
# gonfiano il Repl layer. Mettere in Object Storage, non in git.
exports/

# Runtime upload assets (transient, not tracked)

logs/ota-timing.log

# Oracle ARM Poller — config locale con OCID sensibili (mai committata)
~/.oci/poller.conf
.oci/poller.conf

# Autogenerated PDF/PNG assets — regenerated by post-merge setup, not tracked
docs/matching-system.pdf
server/public/matching-system.pdf
server/public/assets/competitor-analysis.pdf
server/public/assets/competitor-analysis.png

# ESLint cache — generated locally, not tracked
.eslintcache

# Upload runtime utente (foto contest/profilo, codici invito, guide) — non vanno in git
uploads/

# Task #5261 — binario cloudflared bakato dal deploy-build (non versionare)
bin/cloudflared

# Copia read-only di riferimento di BikerBlog (repo gemello).
# Generata/aggiornata da scripts/refresh-bikerblog.sh — mai versionata,
# non deve gonfiare il Repl layer del deploy.
.bikerblog-ref/
logs/*.md

# Neon migration artifacts — contengono dati prod, mai committare
scripts/neon-migration/*.sql
scripts/neon-migration/*.txt
