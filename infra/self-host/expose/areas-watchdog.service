[Unit]
Description=BikerLink — sync istanze GraphHopper-area con stato app (watchdog)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/bikerlink-areas.env
# StateDirectory fa creare a systemd /var/lib/bikerlink/ con i permessi corretti
# al primo avvio del servizio (anche senza che il watchdog la abbia già creata).
StateDirectory=bikerlink
StateDirectoryMode=0755
ExecStart=/opt/bikerlink/expose/areas-watchdog.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=areas-watchdog

[Install]
WantedBy=multi-user.target
