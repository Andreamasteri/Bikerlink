[Unit]
Description=Timer rinnovo certificati Let's Encrypt — due volte al giorno
Documentation=https://certbot.eff.org/docs/
Requires=certbot-renew.service

[Timer]
# Esegui alle 04:30 e alle 16:30 ogni giorno
# L'orario è volutamente non esatto (non a ore tonde) per non sovraccaricare
# i server Let's Encrypt insieme ad altri host che usano la stessa schedulazione
OnCalendar=*-*-* 04:30:00
OnCalendar=*-*-* 16:30:00
# Aggiungi un jitter casuale fino a 60 minuti per distribuire il carico
RandomizedDelaySec=3600
# Esegui subito al boot se l'ultima esecuzione è stata mancata
Persistent=true

[Install]
WantedBy=timers.target
