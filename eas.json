{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "debug-apk": {
      "distribution": "internal",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "ORG_GRADLE_PROJECT_bundleInDebug": "true"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
