{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biker-link.replit.app"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biker-link.replit.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biker-link.replit.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
