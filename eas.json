{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "debug-apk": {
      "distribution": "internal",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "image": "latest"
      }
    },
    "diagnostic-apk": {
      "distribution": "internal",
      "channel": "diagnostic",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app",
        "EXPO_PUBLIC_BUILD_PROFILE": "diagnostic"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -Pandroid.enableProguardInReleaseBuilds=false -Pandroid.enableMinifyInReleaseBuilds=false -Pandroid.enableShrinkResourcesInReleaseBuilds=false",
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      }
    },
    "emergency-apk": {
      "distribution": "internal",
      "channel": "emergency",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "NODE_OPTIONS": "--max_old_space_size=8192",
        "EXPO_PUBLIC_DOMAIN": "bikerlink.replit.app"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "image": "latest"
      },
      "ios": {
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
